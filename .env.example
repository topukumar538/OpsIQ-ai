# ── Required ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:8000

# ── Database (Postgres runs in Docker — see docker-compose.yml) ───────────────
POSTGRES_USER=opsiq
POSTGRES_PASSWORD=opsiq_dev_password
POSTGRES_DB=opsiq

# false for local Docker Postgres; true for hosted providers (Neon, Supabase)
DB_SSL=false

# ── LLM ────────────────────────────────────────────────────────────────────────
MODEL_NAME=llama-3.3-70b-versatile
CHAT_TEMPERATURE=0.7
RAG_TEMPERATURE=0.3
PM_TEMPERATURE=0.1
MAX_TOKEN_LIMIT=2000
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG ────────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4

# ── Postmortem ─────────────────────────────────────────────────────────────────
PM_CHUNK_LINES=30
PM_OVERLAP_LINES=5
PM_TOP_K=4

# ── Upload ─────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Cookie ─────────────────────────────────────────────────────────────────────
COOKIE_NAME=opsiq_session
COOKIE_MAX_AGE=604800
# set true in production (HTTPS only)
COOKIE_SECURE=false          
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# ── Session cache ──────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=7200
SESSION_CLEANUP_INTERVAL_SECONDS=900

# ── FAISS ──────────────────────────────────────────────────────────────────────
# /tmp works for local dev. In production point this at a mounted volume so
# stores survive container restarts (e.g. /mnt/data/opsiq_stores).
FAISS_STORE_DIR=/tmp/opsiq_stores